{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.16.0/schemas/schema.json",
  "services": [
    {
      "product": "Data-And-Analytics-Platform",
      "component": "data-analytics-platform",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/test-and-validate.yml"
          },
          "checks": [
            {
              "name": "unit"
            },
            {
              "name": "code style and linting"
            },
            {
              "name": "vulnerability detection"
            },
            {
              "name": "code quality"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/code-quality-sonarcloud.yml"
          },
          "checks": [
            {
              "name": "unit test coverage"
            },
            {
              "name": "code quality"
            },
            {
              "name": "secret scanning"
            },
            {
              "name": "sensitive data scanning"
            },
            {
              "name": "vulnerability detection"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/ensure-sha-pinned-actions.yml"
          },
          "checks": [
            {
              "name": "vulnerability detection"
            }
          ]
        },
        {
          "phase": "pre-upload",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/test-and-validate.yml"
          },
          "checks": [
            {
              "name": "unit"
            },
            {
              "name": "code style and linting"
            },
            {
              "name": "vulnerability detection"
            },
            {
              "name": "code quality"
            }
          ]
        }
      ]
    }
  ]
}
